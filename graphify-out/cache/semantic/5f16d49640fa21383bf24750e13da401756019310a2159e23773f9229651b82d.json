{"nodes": [{"id": "docs_ipc_security", "label": "IPC Security Documentation", "file_type": "document", "source_file": "docs/IPC_SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_ipc_security_pattern", "label": "Electron IPC Security Pattern", "file_type": "rationale", "source_file": "docs/IPC_SECURITY.md", "source_location": "Architecture section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The layered IPC architecture (Renderer -> window.api -> Preload -> Main) enforces defense in depth: renderer never gets direct Node access, contextBridge exposes only curated APIs, channels are whitelisted via shared ipc.ts, all payloads are validated on both sides, and assertTrustedSender guards every main handler. This prevents renderer compromise from escalating to full OS access."}, {"id": "concept_context_isolation", "label": "Context Isolation Requirement", "file_type": "rationale", "source_file": "docs/IPC_SECURITY.md", "source_location": "BrowserWindow defaults section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "contextIsolation:true, sandbox:true, nodeIntegration:false are mandatory on every BrowserWindow so the renderer JS runs in an isolated world and cannot access Node.js or Electron APIs directly, even if the renderer is compromised by XSS or a supply-chain attack."}], "edges": [{"source": "docs_ipc_security", "target": "preload_index_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/IPC_SECURITY.md", "source_location": "Architecture table", "weight": 1.0}, {"source": "docs_ipc_security", "target": "shared_ipc_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/IPC_SECURITY.md", "source_location": "Architecture table", "weight": 1.0}, {"source": "docs_ipc_security", "target": "main_i