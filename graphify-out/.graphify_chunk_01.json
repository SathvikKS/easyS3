    {
      "id": "concept_ipc_security_pattern",
      "label": "Electron IPC Security Pattern",
      "file_type": "rationale",
      "source_file": "docs/IPC_SECURITY.md",
      "source_location": "Architecture section",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The layered IPC architecture (Renderer -> window.api -> Preload -> Main) enforces defense in depth: renderer never gets direct Node access, contextBridge exposes only curated APIs, channels are whitelisted via shared ipc.ts, all payloads are validated on both sides, and assertTrustedSender guards every main handler. This prevents renderer compromise from escalating to full OS access."
    },
    {
      "id": "concept_context_isolation",
      "label": "Context Isolation Requirement",
      "file_type": "rationale",
      "source_file": "docs/IPC_SECURITY.md",
      "source_location": "BrowserWindow defaults section",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "contextIsolation:true, sandbox:true, nodeIntegration:false are mandatory on every BrowserWindow so the renderer JS runs in an isolated world and cannot access Node.js or Electron APIs directly, even if the renderer is compromised by XSS or a supply-chain attack."
    },
    {
      "id": "concept_gitnexus_knowledge_graph",
      "label": "GitNexus Code Knowledge Graph",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GitNexus indexes the codebase into a graph of symbols and relationships (40 symbols, 35 relationships for easyS3) so agents can reason about blast radius, execution flows, and safe refactoring paths without manually grepping — ensuring changes are made with full dependency awareness."
    },
    {
      "id": "concept_electron_app",
      "label": "Electron + React + TypeScript Application",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "easyS3 is built with Electron for cross-platform desktop distribution, React for the UI, and TypeScript for type safety across both main and renderer processes."
    },
    {
      "id": "concept_csp_renderer",
      "label": "Content Security Policy for Renderer",
      "file_type": "rationale",
      "source_file": "src/renderer/index.html",
      "source_location": "meta http-equiv Content-Security-Policy",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The renderer HTML enforces a strict CSP (default-src 'self', script-src 'self', style-src 'self' 'unsafe-inline', img-src 'self' data:) to prevent XSS and unauthorized resource loading, complementing the IPC security model."
    },
    {
      "id": "concept_gitnexus_impact_before_edit",
      "label": "Mandatory Impact Analysis Before Edits",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "Always Do section",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Agents must run gitnexus_impact before modifying any symbol to surface the blast radius (direct callers, affected processes, risk level) and warn on HIGH/CRITICAL risk, preventing accidental breakage of callers across the codebase."
    },
